{
  "name": "automacao-learningflix",
  "private": true,
  "scripts": {
    "test": "playwright test --project=desktop",
    "test:ui": "playwright test --project=desktop --ui",
    "test:visivel": "playwright test --project=desktop --headed",
    "test:pagina-de-login": "playwright test tests/1-PaginaDeLogin --project=desktop",
    "test:plataforma": "playwright test tests/2-Plataforma --project=desktop",
    "test:login": "playwright test tests/1-PaginaDeLogin/1-Login --project=desktop",
    "test:cadastro": "playwright test tests/1-PaginaDeLogin/2-Cadastro --project=desktop",
    "test:redefinicao-senha": "playwright test tests/1-PaginaDeLogin/3-RedefinicaoSenha --project=desktop",
    "test:rodape": "playwright test tests/1-PaginaDeLogin/4-Rodape --project=desktop",
    "test:carrossel": "playwright test tests/2-Plataforma/1-Carrossel --project=desktop",
    "test:meus-cursos": "playwright test tests/2-Plataforma/2-MeusCursos --project=desktop",
    "test:skill-link": "playwright test tests/2-Plataforma/3-SkillLink --project=desktop",
    "test:skill-link-config": "cross-env EXECUTAR_CONFIG_SKILL_LINK=sim playwright test tests/2-Plataforma/3-SkillLink/valida_configuracao_skill_link_ia.spec.ts --project=desktop",
    "test:skill-link-creditos": "cross-env EXECUTAR_CREDITOS_SKILL_LINK=sim playwright test tests/2-Plataforma/3-SkillLink/valida_creditos_skill_link_altera.spec.ts --project=desktop",
    "test:skill-link-recomendados": "cross-env EXECUTAR_RECOMENDADOS_SKILL_LINK=sim playwright test tests/2-Plataforma/3-SkillLink/valida_cursos_recomendados_altera.spec.ts --project=desktop",
    "test:acesso-visitante": "playwright test tests/1-PaginaDeLogin/5-Visitante --project=desktop",
    "test:cadastro-real": "cross-env EXECUTAR_CADASTRO_REAL=sim playwright test tests/1-PaginaDeLogin/2-Cadastro/valida_cadastro_novo_usuario.spec.ts --project=desktop",
    "test:visitante-config": "cross-env EXECUTAR_CONFIG_VISITANTE=sim playwright test tests/1-PaginaDeLogin/5-Visitante/valida_configuracao_botao_visitante.spec.ts --project=desktop",
    "test:ajuda-envio": "cross-env EXECUTAR_ENVIO_AJUDA=sim playwright test tests/1-PaginaDeLogin/5-Visitante/valida_envio_ajuda_visitante.spec.ts --project=desktop",
    "test:cadastro-config": "cross-env EXECUTAR_CONFIG_CADASTRO=sim playwright test tests/1-PaginaDeLogin/2-Cadastro/valida_configuracao_cadastro.spec.ts --project=desktop",
    "test:redefinicao-config": "cross-env EXECUTAR_CONFIG_REDEFINICAO=sim playwright test tests/1-PaginaDeLogin/3-RedefinicaoSenha/valida_configuracao_redefinicao_personalizada.spec.ts --project=desktop",
    "test:rodape-config": "cross-env EXECUTAR_CONFIG_RODAPE=sim playwright test tests/1-PaginaDeLogin/4-Rodape/valida_configuracao_rodape.spec.ts --project=desktop",
    "test:carrossel-config": "cross-env EXECUTAR_CONFIG_CARROSSEL=sim playwright test tests/2-Plataforma/1-Carrossel/valida_configuracao_carrossel.spec.ts --project=desktop",
    "test:meus-cursos-config": "cross-env EXECUTAR_CONFIG_MEUS_CURSOS=sim playwright test tests/2-Plataforma/2-MeusCursos/valida_configuracao_meus_cursos.spec.ts --project=desktop",
    "test:meus-cursos-novo": "cross-env EXECUTAR_MEUS_CURSOS_NOVO=sim playwright test tests/2-Plataforma/2-MeusCursos/valida_meus_cursos_usuario_novo.spec.ts --project=desktop",
    "test:critico": "playwright test --project=desktop --grep @critico",
    "test:prioridade-alta": "playwright test --project=desktop --grep \"@critico|@alto\"",
    "test:responsivo": "playwright test --project=desktop --grep @responsivo",
    "test:diaria": "playwright test --project=desktop",
    "test:semanal": "cross-env EXECUTAR_CADASTRO_REAL=sim EXECUTAR_CONFIG_CADASTRO=sim EXECUTAR_CONFIG_VISITANTE=sim EXECUTAR_ENVIO_AJUDA=sim EXECUTAR_CONFIG_REDEFINICAO=sim EXECUTAR_CONFIG_RODAPE=sim EXECUTAR_CONFIG_CARROSSEL=sim EXECUTAR_CONFIG_MEUS_CURSOS=sim EXECUTAR_MEUS_CURSOS_NOVO=sim playwright test --project=desktop --grep \"@altera-configuracao|@cria-usuario|@envia-email|@critico\"",
    "rodada:andamento": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/andamento-rodada.ps1",
    "login:perfis": "cross-env LOGIN_NOVO=sim playwright test --project=setup",
    "tutorial:login": "playwright test -c tutoriais --project=login",
    "tutorial:login:cliente": "cross-env PERFIL=cliente playwright test -c tutoriais --project=login",
    "tutorial:login:usuario": "cross-env PERFIL=usuario playwright test -c tutoriais --project=login",
    "tutorial:skill-link:prints": "playwright test -c tutoriais --project=prints prints-secao1",
    "tutorial:skill-link:prints:secao2": "playwright test -c tutoriais --project=prints-cliente cliente-secao2 && playwright test -c tutoriais --project=prints prints-secao2",
    "tutorial:skill-link:prints:secao3": "playwright test -c tutoriais --project=prints-cliente cliente-secao3 && playwright test -c tutoriais --project=prints prints-secao3-admin",
    "tutorial:skill-link:prints:secao4": "playwright test -c tutoriais --project=prints-cliente cliente-secao4",
    "tutorial:skill-link:prints:secao5": "cross-env RECAPTURAR=sim playwright test -c tutoriais --project=prints-cliente cliente-secao5 && cross-env CARGO_EVA=print playwright test -c tutoriais --project=prints-cliente cliente-cargo-eva",
    "tutorial:skill-link:prints:secao6": "playwright test -c tutoriais --project=prints-usuario usuario-secao6",
    "tutorial:skill-link:restaurar-cargo-eva": "cross-env CARGO_EVA=original playwright test -c tutoriais --project=prints-cliente cliente-cargo-eva",
    "tutorial:skill-link:confluence:seco": "cross-env SECO=sim playwright test -c tutoriais --project=confluence",
    "tutorial:skill-link:confluence": "playwright test -c tutoriais --project=confluence",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tutorial:judy:prints": "playwright test -c tutoriais --project=prints prints-judy-admin && playwright test -c tutoriais --project=prints-usuario usuario-judy",
    "tutorial:judy:confluence:seco": "cross-env TUTORIAL=judy SECO=sim playwright test -c tutoriais --project=confluence",
    "tutorial:judy:confluence": "cross-env TUTORIAL=judy playwright test -c tutoriais --project=confluence",
    "tutorial:lote:prints": "cross-env FASE=antes playwright test -c tutoriais --project=prints prints-lote.tutorial",
    "tutorial:lote:resultado": "cross-env FASE=depois playwright test -c tutoriais --project=prints prints-lote.tutorial",
    "tutorial:lote:confluence:seco": "cross-env TUTORIAL=lote SECO=sim playwright test -c tutoriais --project=confluence",
    "tutorial:lote:confluence": "cross-env TUTORIAL=lote playwright test -c tutoriais --project=confluence",
    "tutorial:conversor:prints": "playwright test -c tutoriais --project=prints-cliente cliente-conversor.tutorial",
    "tutorial:conversor:confluence:seco": "cross-env TUTORIAL=conversor SECO=sim playwright test -c tutoriais --project=confluence",
    "tutorial:conversor:confluence": "cross-env TUTORIAL=conversor playwright test -c tutoriais --project=confluence"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
